# ── Copy this file to .env and fill in all values ────────────────────────────
# .env is gitignored and must NEVER be committed to the repository

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Serper (web search)
SERPER_API_KEY=...

# Database — password only (URL is built automatically in docker-compose.yml)
DB_PASSWORD=use_a_long_random_password_here

# CORS — the URL users will access the app from
ALLOWED_ORIGINS=http://sourcingagent.10pearls.com

# Rate limiting — max search requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# Microsoft Azure AD auth (required for VM deployment)
AZURE_CLIENT_ID=89a89132-cc9d-4492-ac67-1c4b54f37932
AZURE_TENANT_ID=3c6322bf-c349-48f5-bdc9-750baa5c79a8
REQUIRE_AUTH=true

# Frontend build arg — must match REQUIRE_AUTH above
VITE_REQUIRE_AUTH=true
